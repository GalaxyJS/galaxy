{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "maxNodeModuleJsDepth": 0,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022"
  },
  "include": ["main.js", "test.js", "vite.config.js", "eslint.config.js", "src/**/*.js"],
  "exclude": ["dist", "docs", "node_modules", "site"]
}
